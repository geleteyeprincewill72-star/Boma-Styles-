{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information, metadata, and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "bio": { "type": "string" },
        "avatar": { "type": "string" },
        "coverPhoto": { "type": "string" },
        "website": { "type": "string" },
        "location": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "role": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["uid", "username", "displayName", "email", "role", "createdAt"]
    },
    "Post": {
      "title": "Feed Post",
      "description": "Social feed content, videos, media or text.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPublicKey": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["id", "authorName", "content", "timestamp"]
    },
    "Chat": {
      "title": "Chat Conversation",
      "description": "A private one-to-one or group (Circle) chat room.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "members": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "integer" },
        "lastMessageSender": { "type": "string" },
        "retentionDays": { "type": "integer" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "type", "members", "createdAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "A message sent inside a Chat room.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "timestamp": { "type": "integer" },
        "readBy": { "type": "array" }
      },
      "required": ["id", "senderId", "senderName", "text", "timestamp"]
    },
    "Notification": {
      "title": "User Notification",
      "description": "A push or in-app notification record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "type": { "type": "string" },
        "postId": { "type": "string" },
        "chatId": { "type": "string" },
        "messageText": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "integer" }
      },
      "required": ["id", "recipientId", "senderId", "senderName", "type", "read", "timestamp"]
    },
    "PaymentConfig": {
      "title": "Payment Configuration",
      "description": "Dynamic banking billing payment settings for upgrades.",
      "type": "object",
      "properties": {
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["bankName", "accountNumber"]
    },
    "AiMessage": {
      "title": "AI Assistant Message",
      "description": "Individual message in user's private AI chat history thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "integer" },
        "thoughtProcess": { "type": "string" },
        "modeUsed": { "type": "string" },
        "hasGeneratedMedia": { "type": "boolean" },
        "mediaType": { "type": "string" },
        "mediaTitle": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "generatedCode": { "type": "string" },
        "isWebSearchGrounded": { "type": "boolean" }
      },
      "required": ["id", "sender", "content", "timestamp"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Firestore connection health check entity",
      "type": "object",
      "properties": {
        "connected": { "type": "boolean" },
        "timestamp": { "type": "number" }
      }
    },
    "AppUpdate": {
      "title": "App Update",
      "description": "Weekly application release notes, improvements, bug fixes, and security updates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "releaseDate": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "newFeatures": { "type": "array" },
        "bugFixes": { "type": "array" },
        "performanceImprovements": { "type": "array" },
        "securityImprovements": { "type": "array" },
        "importantAnnouncements": { "type": "array" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "version", "releaseDate", "status", "createdAt"]
    },
    "FeedbackReview": {
      "title": "User Feedback Review",
      "description": "User reviews, star ratings, categorized suggestions, and bug reports.",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string" },
        "ownerId": { "type": "string" },
        "authorName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "category": { "type": "string" },
        "suggestion": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "status": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["reviewId", "ownerId", "rating", "comment", "category", "status", "createdAt"]
    },
    "ReviewReport": {
      "title": "Review Moderation Report",
      "description": "User report against inappropriate or spam reviews.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reviewId": { "type": "string" },
        "reporterUserId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["id", "reviewId", "reporterUserId", "reason", "timestamp"]
    }
  },
  "firestore": {
    "test/{testId}": {
      "schema": "TestConnection",
      "description": "Connection test path"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Registered users profiles"
    },
    "posts/{postId}": {
      "schema": "Post",
      "description": "Public social feed posts"
    },
    "ai_threads/{userId}/messages/{messageId}": {
      "schema": "AiMessage",
      "description": "User's persistent private AI Assistant chat thread history"
    },
    "chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat conversations metadata"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual chat messages"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications list"
    },
    "payment_config/{configId}": {
      "schema": "PaymentConfig",
      "description": "Payment bank name and account details config"
    },
    "app_updates/{updateId}": {
      "schema": "AppUpdate",
      "description": "Weekly application updates, releases, and changelogs"
    },
    "feedback_reviews/{reviewId}": {
      "schema": "FeedbackReview",
      "description": "User reviews, star ratings, categorized feedback, and bug reports"
    },
    "review_reports/{reportId}": {
      "schema": "ReviewReport",
      "description": "Community review moderation reports"
    }
  }
}

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK API CONFIGURATION (Paystack Payment Gateway)
# Public key exposed to the client browser for Paystack Popup JS / Checkout.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_599c24ca711aabc199bc7b2b80a4f09dd32b6294"

# Secret key kept strictly on server side for verifying transactions & initiating transfers.
PAYSTACK_SECRET_KEY="sk_test_sample123456789"

# Webhook secret key for verifying HMAC SHA512 signatures on incoming Paystack webhooks.
PAYSTACK_WEBHOOK_SECRET="whsec_sample123456789"

# GOOGLE ADSENSE CONFIGURATION (Web Monetization)
# Google AdSense Publisher ID for web monetization
VITE_ADSENSE_PUBLISHER_ID="ca-pub-3940256099942544"



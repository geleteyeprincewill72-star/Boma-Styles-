rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all safety gate denying everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'geleteyeprincewill72@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // --- CONNECTION TEST PATH ---
    match /test/{testId} {
      allow read: if true;
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- AI ASSISTANT CHAT THREADS ---
    match /ai_threads/{userId}/messages/{messageId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- CHAT CONVERSATIONS & CIRCLES ---
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.members);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members || isAdmin());
      allow delete: if isAdmin();

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members || isAdmin());
        allow create, update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // --- SOCIAL FEED & CHANNELS ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId);
      allow update: if isSignedIn() && isValidId(postId);
      allow delete: if isSignedIn() && (resource.data.authorPublicKey == request.auth.uid || isAdmin());
    }

    // --- FOLLOWS SYSTEM ---
    match /follows/{followId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- NOTIFICATIONS SYSTEM ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // --- USER REPORT CENTER ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- SYSTEM AUDIT LOG ---
    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // --- HERITAGE MOUNTING PLACES ---
    match /characters/{charId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /screenplay/{blockId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- PAYMENT CONFIGURATION ---
    match /payment_config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
